{
  "name": "package-hub",
  "publisher": "packagehub",
  "displayName": "PackageHub",
  "description": "Intelligent Package & Project Reference Hub for .NET / C# developers. Explains yellow warnings, shows vulnerabilities & outdated packages.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "nuget",
    "dotnet",
    "csharp",
    "package",
    "vulnerability",
    "dependencies"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:csharp",
    "workspaceContains:**/*.{csproj,sln,props}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "packageHub.scanWorkspace",
        "title": "PackageHub: Scan Workspace"
      },
      {
        "command": "packageHub.showHealthDashboard",
        "title": "PackageHub: Show Health Dashboard"
      },
      {
        "command": "packageHub.explainSelectedPackage",
        "title": "PackageHub: Explain Selected Package"
      },
      {
        "command": "packageHub.restoreAll",
        "title": "PackageHub: Restore All"
      },
      {
        "command": "packageHub.updateVulnerable",
        "title": "PackageHub: Update Vulnerable"
      },
      {
        "command": "packageHub.updateSelectedPackage",
        "title": "PackageHub: Update Package"
      },
      {
        "command": "packageHub.showPackageInfo",
        "title": "PackageHub: Show Package Info"
      },
      {
        "command": "packageHub.openNugetPage",
        "title": "PackageHub: Open on NuGet"
      },
      {
        "command": "packageHub.showDependencyGraph",
        "title": "PackageHub: Dependencies"
      },
      {
        "command": "packageHub.copyHealthReport",
        "title": "PackageHub: Copy Health Report"
      },
      {
        "command": "packageHub.updateHighestPatch",
        "title": "PackageHub: Update to Highest Patch"
      },
      {
        "command": "packageHub.updateHighestMinor",
        "title": "PackageHub: Update to Highest Minor"
      },
      {
        "command": "packageHub.whyPackage",
        "title": "PackageHub: Why is this here?"
      },
      {
        "command": "packageHub.ignorePackage",
        "title": "PackageHub: Ignore Package"
      },
      {
        "command": "packageHub.unignorePackage",
        "title": "PackageHub: Unignore Package"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "packageHub",
          "title": "PackageHub",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "packageHub": [
        {
          "id": "packageHubExplorer",
          "name": "Package Health",
          "icon": "$(package)"
        }
      ]
    },
    "configuration": [
      {
        "title": "PackageHub",
        "properties": {
          "packageHub.dashboardViewMode": {
            "type": "string",
            "enum": [
              "list",
              "byProject",
              "byPackage"
            ],
            "default": "list",
            "description": "Dashboard paket görünüm modu"
          },
          "packageHub.scanOnStartup": {
            "type": "boolean",
            "default": true,
            "description": "Workspace açılınca otomatik paket taraması yap"
          },
          "packageHub.ignoredPackages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Scan sonuçlarından gizlenecek paket id listesi"
          }
        }
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "packageHub.updateSelectedPackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@1"
        },
        {
          "command": "packageHub.showPackageInfo",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@2"
        },
        {
          "command": "packageHub.openNugetPage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@3"
        },
        {
          "command": "packageHub.ignorePackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@4"
        },
        {
          "command": "packageHub.showDependencyGraph",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@5"
        },
        {
          "command": "packageHub.whyPackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@6"
        }
      ],
      "editor/context": [
        {
          "command": "packageHub.showDependencyGraph",
          "when": "resourceExtname == .csproj || resourceExtname == .props",
          "group": "packageHub@1"
        },
        {
          "command": "packageHub.whyPackage",
          "when": "resourceExtname == .csproj || resourceExtname == .props",
          "group": "packageHub@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}