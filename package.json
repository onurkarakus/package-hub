{
  "name": "package-hub",
  "publisher": "onurkarakus",
  "displayName": "PackageHub",
  "description": "Manage your NuGet packages in the editor. See which ones need attention, then update them in a few clicks.",
  "version": "0.0.3",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "nuget",
    "dotnet",
    "csharp",
    "fsharp",
    "csproj",
    "fsproj",
    "vulnerability",
    "dependencies",
    "security",
    "audit"
  ],
  "icon": "media/packagehub-logo.png",
  "galleryBanner": {
    "color": "#184E57",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:csharp",
    "onLanguage:fsharp",
    "workspaceContains:**/*.{csproj,fsproj,sln,props}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "packageHub.scanWorkspace",
        "title": "PackageHub: Scan Workspace",
        "icon": "$(search)"
      },
      {
        "command": "packageHub.showHealthDashboard",
        "title": "PackageHub: Show Health Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "packageHub.explainSelectedPackage",
        "title": "PackageHub: Explain Selected Package"
      },
      {
        "command": "packageHub.restoreAll",
        "title": "PackageHub: Restore All"
      },
      {
        "command": "packageHub.updateVulnerable",
        "title": "PackageHub: Update Vulnerable"
      },
      {
        "command": "packageHub.updateSelectedPackage",
        "title": "PackageHub: Update Package"
      },
      {
        "command": "packageHub.showPackageInfo",
        "title": "PackageHub: Show Package Info"
      },
      {
        "command": "packageHub.openNugetPage",
        "title": "PackageHub: Open on NuGet"
      },
      {
        "command": "packageHub.showDependencyGraph",
        "title": "PackageHub: Dependencies"
      },
      {
        "command": "packageHub.copyHealthReport",
        "title": "PackageHub: Copy Health Report"
      },
      {
        "command": "packageHub.copyVulnerabilityReport",
        "title": "PackageHub: Copy Vulnerability Report"
      },
      {
        "command": "packageHub.updateHighestPatch",
        "title": "PackageHub: Update All to Highest Patch"
      },
      {
        "command": "packageHub.updateHighestMinor",
        "title": "PackageHub: Update All to Highest Minor"
      },
      {
        "command": "packageHub.whyPackage",
        "title": "PackageHub: Why is this here?"
      },
      {
        "command": "packageHub.ignorePackage",
        "title": "PackageHub: Ignore Package"
      },
      {
        "command": "packageHub.unignorePackage",
        "title": "PackageHub: Unignore Package"
      },
      {
        "command": "packageHub.removePackage",
        "title": "PackageHub: Remove Package"
      },
      {
        "command": "packageHub.updateLinePatch",
        "title": "PackageHub: Update to Highest Patch"
      },
      {
        "command": "packageHub.updateLineLatest",
        "title": "PackageHub: Update to Latest"
      },
      {
        "command": "packageHub.openLineAdvisory",
        "title": "PackageHub: Open Advisory"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "packageHub",
          "title": "PackageHub",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "packageHub": [
        {
          "id": "packageHubExplorer",
          "name": "Package Health",
          "icon": "$(package)"
        }
      ]
    },
    "configuration": [
      {
        "title": "PackageHub",
        "properties": {
          "packageHub.dashboardViewMode": {
            "type": "string",
            "enum": [
              "list",
              "byProject",
              "byPackage"
            ],
            "default": "list",
            "description": "Dashboard layout: list, by project, or by package."
          },
          "packageHub.scanOnStartup": {
            "type": "boolean",
            "default": true,
            "description": "Scan packages when the workspace opens."
          },
          "packageHub.includePrerelease": {
            "type": "boolean",
            "default": false,
            "description": "Include prereleases in the next outdated list. Off by default. The vulnerability scan is unchanged. Applied on the next scan."
          },
          "packageHub.minimumSeverity": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "critical"
            ],
            "default": "low",
            "description": "Lowest severity PackageHub reports. Does not change NuGetAuditLevel in the project."
          },
          "packageHub.minimumReleaseAge": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "How many days old a latest version must be before it is preferred. 0 is off. Highest patch ignores this."
          },
          "packageHub.ignoredPackages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Package ids to hide from scan results."
          }
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "packageHub.scanWorkspace",
          "when": "view == packageHubExplorer",
          "group": "navigation@1"
        },
        {
          "command": "packageHub.showHealthDashboard",
          "when": "view == packageHubExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "packageHub.updateSelectedPackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@1"
        },
        {
          "command": "packageHub.showPackageInfo",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@2"
        },
        {
          "command": "packageHub.openNugetPage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@3"
        },
        {
          "command": "packageHub.ignorePackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@4"
        },
        {
          "command": "packageHub.showDependencyGraph",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@5"
        },
        {
          "command": "packageHub.whyPackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@6"
        },
        {
          "command": "packageHub.removePackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@7"
        }
      ],
      "editor/context": [
        {
          "command": "packageHub.updateLinePatch",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@1"
        },
        {
          "command": "packageHub.updateLineLatest",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@2"
        },
        {
          "command": "packageHub.openLineAdvisory",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@3"
        },
        {
          "command": "packageHub.whyPackage",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@4"
        },
        {
          "command": "packageHub.ignorePackage",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@5"
        },
        {
          "command": "packageHub.removePackage",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@6"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}