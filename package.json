{
  "name": "package-hub",
  "publisher": "onurkarakus",
  "displayName": "PackageHub",
  "description": "Manage your NuGet packages in the editor. See which ones need attention, then update them in a few clicks.",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Onur Karakuş"
  },
  "homepage": "https://github.com/onurkarakus/package-hub#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/onurkarakus/package-hub.git"
  },
  "bugs": {
    "url": "https://github.com/onurkarakus/package-hub/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "nuget",
    "dotnet",
    "csharp",
    "fsharp",
    "csproj",
    "fsproj",
    "vulnerability",
    "dependencies",
    "security",
    "audit"
  ],
  "icon": "media/packagehub-logo.png",
  "galleryBanner": {
    "color": "#184E57",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/*.{csproj,fsproj,sln,slnx}",
    "workspaceContains:**/Directory.Packages.props"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PackageHub runs dotnet and MSBuild, which can run code from the workspace. Trust the folder to scan it."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "packageHub.scanWorkspace",
        "title": "%command.scanWorkspace%",
        "icon": "$(search)"
      },
      {
        "command": "packageHub.showHealthDashboard",
        "title": "%command.showHealthDashboard%",
        "icon": "$(dashboard)"
      },
      {
        "command": "packageHub.explainSelectedPackage",
        "title": "%command.explainSelectedPackage%"
      },
      {
        "command": "packageHub.restoreAll",
        "title": "%command.restoreAll%"
      },
      {
        "command": "packageHub.updateVulnerable",
        "title": "%command.updateVulnerable%"
      },
      {
        "command": "packageHub.updateSelectedPackage",
        "title": "%command.updateSelectedPackage%"
      },
      {
        "command": "packageHub.showPackageInfo",
        "title": "%command.showPackageInfo%"
      },
      {
        "command": "packageHub.openNugetPage",
        "title": "%command.openNugetPage%"
      },
      {
        "command": "packageHub.showDependencyGraph",
        "title": "%command.showDependencyGraph%"
      },
      {
        "command": "packageHub.copyHealthReport",
        "title": "%command.copyHealthReport%"
      },
      {
        "command": "packageHub.copyVulnerabilityReport",
        "title": "%command.copyVulnerabilityReport%"
      },
      {
        "command": "packageHub.updateHighestPatch",
        "title": "%command.updateHighestPatch%"
      },
      {
        "command": "packageHub.updateHighestMinor",
        "title": "%command.updateHighestMinor%"
      },
      {
        "command": "packageHub.whyPackage",
        "title": "%command.whyPackage%"
      },
      {
        "command": "packageHub.ignorePackage",
        "title": "%command.ignorePackage%"
      },
      {
        "command": "packageHub.unignorePackage",
        "title": "%command.unignorePackage%"
      },
      {
        "command": "packageHub.removePackage",
        "title": "%command.removePackage%"
      },
      {
        "command": "packageHub.updateLinePatch",
        "title": "%command.updateLinePatch%"
      },
      {
        "command": "packageHub.updateLineLatest",
        "title": "%command.updateLineLatest%"
      },
      {
        "command": "packageHub.openLineAdvisory",
        "title": "%command.openLineAdvisory%"
      },
      {
        "command": "packageHub.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "icon": "$(book)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "packageHub",
          "title": "%viewsContainer.packageHub.title%",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "packageHub": [
        {
          "id": "packageHubExplorer",
          "name": "%view.packageHubExplorer.name%",
          "icon": "$(package)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "packageHubExplorer",
        "when": "workspaceFolderCount == 0",
        "contents": "%welcome.noFolder%"
      },
      {
        "view": "packageHubExplorer",
        "when": "workspaceFolderCount > 0 && packageHub.noProjects",
        "contents": "%welcome.noProjects%"
      }
    ],
    "walkthroughs": [
      {
        "id": "packageHub.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "packageHub.open",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.description%",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onContext:packageHub.hasProjects"
            ]
          },
          {
            "id": "packageHub.scan",
            "title": "%walkthrough.scan.title%",
            "description": "%walkthrough.scan.description%",
            "media": {
              "image": "media/walkthrough/scan.png",
              "altText": "The Package Health view after a scan, with vulnerable, outdated and deprecated packages"
            },
            "completionEvents": [
              "onContext:packageHub.scanCompleted",
              "onCommand:packageHub.scanWorkspace"
            ]
          },
          {
            "id": "packageHub.marks",
            "title": "%walkthrough.marks.title%",
            "description": "%walkthrough.marks.description%",
            "media": {
              "image": "media/walkthrough/marks.png",
              "altText": "Package lines with a warning, a cross with the newer version, and a check"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "packageHub.update",
            "title": "%walkthrough.update.title%",
            "description": "%walkthrough.update.description%",
            "media": {
              "image": "media/walkthrough/quick-fix.png",
              "altText": "The lightbulb menu on a vulnerable package"
            },
            "completionEvents": [
              "onCommand:packageHub.updateVulnerable"
            ]
          },
          {
            "id": "packageHub.health",
            "title": "%walkthrough.health.title%",
            "description": "%walkthrough.health.description%",
            "media": {
              "image": "media/walkthrough/dashboard.png",
              "altText": "The Health Dashboard"
            },
            "completionEvents": [
              "onCommand:packageHub.showHealthDashboard"
            ]
          },
          {
            "id": "packageHub.why",
            "title": "%walkthrough.why.title%",
            "description": "%walkthrough.why.description%",
            "media": {
              "image": "media/walkthrough/why.png",
              "altText": "The path window for one package"
            },
            "completionEvents": [
              "onCommand:packageHub.whyPackage"
            ]
          },
          {
            "id": "packageHub.settings",
            "title": "%walkthrough.settings.title%",
            "description": "%walkthrough.settings.description%",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            },
            "completionEvents": [
              "onSettingChanged:packageHub.minimumSeverity",
              "onSettingChanged:packageHub.includePrerelease",
              "onSettingChanged:packageHub.minimumReleaseAge"
            ]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "PackageHub",
        "properties": {
          "packageHub.scanOnStartup": {
            "type": "boolean",
            "default": true,
            "description": "%config.scanOnStartup.description%"
          },
          "packageHub.includePrerelease": {
            "type": "boolean",
            "default": false,
            "description": "%config.includePrerelease.description%"
          },
          "packageHub.minimumSeverity": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "critical"
            ],
            "default": "low",
            "description": "%config.minimumSeverity.description%"
          },
          "packageHub.minimumReleaseAge": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "%config.minimumReleaseAge.description%"
          },
          "packageHub.ignoredPackages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.ignoredPackages.description%"
          },
          "packageHub.onlineLookups": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.onlineLookups.markdownDescription%"
          },
          "packageHub.timeouts.listSeconds": {
            "type": "number",
            "default": 120,
            "minimum": 10,
            "description": "%config.timeouts.listSeconds.description%"
          },
          "packageHub.timeouts.outdatedSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 10,
            "description": "%config.timeouts.outdatedSeconds.description%"
          },
          "packageHub.timeouts.restoreSeconds": {
            "type": "number",
            "default": 600,
            "minimum": 10,
            "description": "%config.timeouts.restoreSeconds.description%"
          },
          "packageHub.maxDotnetProcesses": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 16,
            "description": "%config.maxDotnetProcesses.description%"
          }
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "packageHub.scanWorkspace",
          "when": "view == packageHubExplorer",
          "group": "navigation@1"
        },
        {
          "command": "packageHub.showHealthDashboard",
          "when": "view == packageHubExplorer",
          "group": "navigation@2"
        },
        {
          "command": "packageHub.openWalkthrough",
          "when": "view == packageHubExplorer",
          "group": "packageHub@9"
        }
      ],
      "view/item/context": [
        {
          "command": "packageHub.updateSelectedPackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@1"
        },
        {
          "command": "packageHub.showPackageInfo",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@2"
        },
        {
          "command": "packageHub.openNugetPage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@3"
        },
        {
          "command": "packageHub.ignorePackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@4"
        },
        {
          "command": "packageHub.showDependencyGraph",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@5"
        },
        {
          "command": "packageHub.whyPackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@6"
        },
        {
          "command": "packageHub.removePackage",
          "when": "view == packageHubExplorer && viewItem == packageHub.package",
          "group": "packageHub@7"
        }
      ],
      "editor/context": [
        {
          "command": "packageHub.updateLinePatch",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@1"
        },
        {
          "command": "packageHub.updateLineLatest",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@2"
        },
        {
          "command": "packageHub.openLineAdvisory",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@3"
        },
        {
          "command": "packageHub.whyPackage",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@4"
        },
        {
          "command": "packageHub.ignorePackage",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@5"
        },
        {
          "command": "packageHub.removePackage",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props",
          "group": "packageHub@6"
        }
      ],
      "commandPalette": [
        {
          "command": "packageHub.updateVulnerable",
          "when": "false"
        },
        {
          "command": "packageHub.updateSelectedPackage",
          "when": "false"
        },
        {
          "command": "packageHub.showPackageInfo",
          "when": "false"
        },
        {
          "command": "packageHub.openNugetPage",
          "when": "false"
        },
        {
          "command": "packageHub.updateLinePatch",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props"
        },
        {
          "command": "packageHub.updateLineLatest",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props"
        },
        {
          "command": "packageHub.openLineAdvisory",
          "when": "resourceExtname == .csproj || resourceExtname == .fsproj || resourceExtname == .props"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:min": "node scripts/test-min.mjs",
    "publish:ovsx": "npx --yes ovsx publish",
    "package:vsix": "npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "~1.74.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
